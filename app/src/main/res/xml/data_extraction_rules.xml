<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Keep the AI key out of cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ai_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ai_secure.xml" />
    </device-transfer>
</data-extraction-rules>
